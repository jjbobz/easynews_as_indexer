# Copy this file to .env and fill in your credentials

EASYNEWS_USER=your_easynews_username
EASYNEWS_PASS=your_easynews_password

# API key used by Prowlarr/Newznab clients to authenticate to this server
NEWZNAB_APIKEY=testkey

# Optional: override server port (default 8081)
# PORT=8081

# Optional: public URL used in RSS/Newznab result links.
# Set this when running behind Docker, a reverse proxy, or multiple instances.
# PUBLIC_URL=http://10.10.10.5:8081
# BASE_URL=http://10.10.10.5:8081

# Optional: strict title matching for movie/tvsearch. Use 0 to broaden matching.
# STRICT_MATCHING=1
